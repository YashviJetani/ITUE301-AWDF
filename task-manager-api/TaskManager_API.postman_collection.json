        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Complete Practical 1 to 6 in React and Node\",\n  \"description\": \"Build modern portfolio, route setup, GitHub API fetch, and Express Mongoose full stack app.\",\n  \"priority\": \"high\",\n  \"completed\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Creates a task with high priority."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Task title matches', function () {",
              "    pm.expect(jsonData.data.title).to.eql('Complete Practical 1 to 6 in React and Node');",
              "    pm.expect(jsonData.data.priority).to.eql('high');",
              "});",
              "// Save created ID for subsequent tests",
              "if (jsonData.data && jsonData.data._id) {",
              "    pm.collectionVariables.set('taskId', jsonData.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
